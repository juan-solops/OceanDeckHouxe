<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ocean Deck House | Blog and Contact Us</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f9fafb;
      color: #1a1a2e;
      line-height: 1.6;
    }

    h1, h2, h3 {
      font-family: 'Playfair Display', serif;
      color: #0a2342;
    }

    a {
      text-decoration: none;
      color: #2eb8b8;
      transition: color 0.3s;
    }

    a:hover {
      color: #1a6b8a;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px;
    }

    .section-hdr {
      text-align: center;
      margin-bottom: 40px;
    }

    .section-hdr .section-tag {
      display: inline-block;
      background-color: #e0f7fa;
      color: #00796b;
      padding: 5px 15px;
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 600;
      text-transform: uppercase;
      margin-bottom: 15px;
    }

    .section-hdr h2 {
      font-size: 2rem;
      margin-bottom: 15px;
    }

    .section-sub {
      font-size: 1rem;
      color: #6b7280;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Blog Section */
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }

    .bl-card {
      background: #ffffff;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      transition: transform 0.3s;
    }

    .bl-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .bl-img img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .bl-body {
      padding: 20px;
    }

    .bl-tag {
      display: inline-block;
      background: #e0f7fa;
      color: #00796b;
      padding: 5px 10px;
      border-radius: 5px;
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .bl-body h3 {
      font-size: 1.2rem;
      margin-bottom: 10px;
    }

    .bl-read {
      display: inline-flex;
      align-items: center;
      font-size: 0.9rem;
      font-weight: 600;
      color: #00796b;
      transition: color 0.3s;
    }

    .bl-read i {
      margin-left: 5px;
    }

    .bl-read:hover {
      color: #004d40;
    }

    .bl-soon {
      text-align: center;
      margin-top: 30px;
      padding: 20px;
      background: #f5efe6;
      border-radius: 10px;
      border: 1px dashed #2eb8b8;
    }

    /* Contact Section */
    .contact {
      background-color: #0a2342;
      color: #ffffff;
      padding: 60px 20px;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .c-info {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .c-item {
      display: flex;
      gap: 15px;
      align-items: flex-start;
    }

    .c-icon {
      width: 50px;
      height: 50px;
      background: rgba(46, 184, 184, 0.15);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #2eb8b8;
      font-size: 1.2rem;
    }

    .c-item h4 {
      font-size: 1rem;
      margin-bottom: 5px;
    }

    .c-item a, .c-item p {
      color: rgba(255, 255, 255, 0.8);
      font-size: 0.9rem;
    }

    .c-item a:hover {
      color: #2eb8b8;
    }

    .c-tip {
      background: rgba(46, 184, 184, 0.1);
      border: 1px solid rgba(46, 184, 184, 0.3);
      border-radius: 10px;
      padding: 15px;
      color: rgba(255, 255, 255, 0.8);
      font-size: 0.9rem;
    }

    .c-form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .f-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .f-grp {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .f-grp label {
      font-size: 0.85rem;
      font-weight: 600;
    }

    .f-grp input, .f-grp textarea, .f-grp select {
      padding: 10px;
      border-radius: 5px;
      border: none;
      font-size: 0.9rem;
    }

    .btn-send {
      background: #2eb8b8;
      color: #ffffff;
      font-size: 1rem;
      font-weight: 600;
      padding: 12px 20px;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      transition: background 0.3s;
    }

    .btn-send:hover {
      background: #00796b;
    }

    .form-success {
      display: none;
      color: #2eb8b8;
      font-weight: 600;
      text-align: center;
      padding: 15px;
      background: rgba(46, 184, 184, 0.1);
      border: 1px solid #2eb8b8;
      border-radius: 10px;
    }

    /* Footer */
    footer {
      background: #050f1e;
      padding: 40px 20px;
      text-align: center;
    }

    .ft-logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.6rem;
      color: #ffffff;
      margin-bottom: 10px;
    }

    .ft-logo span {
      color: #2eb8b8;
    }

    .ft-tag {
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.9rem;
      margin-bottom: 20px;
    }

    .ft-links {
      display: flex;
      gap: 20px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .ft-links a {
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.85rem;
      text-decoration: none;
      transition: color 0.3s;
    }

    .ft-links a:hover {
      color: #2eb8b8;
    }

    .ft-copy {
      color: rgba(255, 255, 255, 0.4);
      font-size: 0.8rem;
    }

    .ft-copy a {
      color: #2eb8b8;
      text-decoration: none;
    }

    .ft-copy a:hover {
      color: #00796b;
    }
  </style>
</head>
<body>
  <!-- Blog and Contact sections are styled with the CSS above -->
</body>
</html>
